# Copy to .env (git-ignored) and load with:  set -a; . ./.env; set +a
# Placeholders only. Never commit real values.
ORDERFLOW_MAX_REJECT_RATIO=0.30
ORDERFLOW_MAX_ATTEMPTS=3
ORDERFLOW_TASK_TIMEOUT_S=300
ORDERFLOW_BACKOFF_BASE_S=1.0
# Optional failure webhook (must be https). Leave empty to disable.
ORDERFLOW_WEBHOOK_URL=
# Set to 0 to keep only a SHA-256 of rejected rows instead of the original values
ORDERFLOW_QUARANTINE_STORE_RAW=1
# Fixed "now" for future-timestamp rules (ISO-8601 with timezone); empty = current time
ORDERFLOW_AS_OF=
